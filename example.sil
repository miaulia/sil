func main() {
	// you need a keyword for setting local vars
	let x = 0;
	// thats so that it really stands out.
	set x = 1;
}

type Add[t] = func(x t, y t) t;

type Vector(x Int, y Int);

type Expr[t] {
	add(Expr[t], Expr[t]);
	val(t);
}

func (e Expr[t]) eval() t
with Number[t]
{
	if e is {
		Expr.add(a, b) {
			a.Number.add(b)
		}
		Expr.val(a) {
			a
		}
	}
}

type BenefitType {
	ssi = 0;
	ssdi = 1;
}

const pi = 3.14;

func pair(a Int, b Int) type(x Int, y Int) {
	type(x = a, y = b)
}

func get_sign(x Int) type{neg; zero; pos} {
	type.neg
}

func i_take_anon(call_me func() Int) Int {
	call_me()
}

func i_pass_anon() {
	i_take_anon(func() { 0 });
	i_take_anon(func() 0);
}

interface Number[t] {
	type Output;
	const zero t;
	func (lhs t) add(rhs t) Output;
}

implement Number[t] {
	type Output = Int;
	const zero Int = 0;
	func (lhs Int) add(rhs Int) Int {
		lhs + rhs
	}
}

// Requiring others, empty interfaces
interface A[t]
with B[t]
{}

interface B[t] {}

implement A[t]
with B[t]
{}

implement B[t] {}

// for the demonstration below
interface Handler[t] {
	func (t) handle();
}

// its like dyn types in rust. t is any type.
// with turns it into a fat pointer. or something like
// that. yea lets say that.
type Holder(handlers List[t with Handler[t]]);

func (h Holder) run() {
	for handler in h.handlers {
		handler.handle();
	}
}

// private stuff exists
priv func im_priv() {
	// ya
}

// including fields
type Secret(priv secret Int);
